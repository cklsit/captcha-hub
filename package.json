{
  "name": "mail-hub",
  "productName": "Mail Hub",
  "version": "1.0.0",
  "description": "邮件中心 (Mail Hub) — 本地优先的 Windows 桌面邮件客户端，多账户收发 + 验证码高亮 + TOTP",
  "author": "Mail Hub Team",
  "license": "MIT",
  "private": true,
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:win": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "imapflow": "^1.0.164",
    "jsqr": "^1.4.0",
    "mailparser": "^3.7.1",
    "nodemailer": "^6.10.1",
    "otplib": "^12.0.1",
    "sanitize-html": "^2.18.0"
  },
  "devDependencies": {
    "@emotion/react": "^11.13.0",
    "@emotion/styled": "^11.13.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mailparser": "^3.4.4",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^30.5.1",
    "electron-builder": "^24.13.3",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.41",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vite-plugin-electron": "^0.28.7",
    "vitest": "^2.0.5"
  }
}
